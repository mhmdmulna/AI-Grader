# Database
# Update with your PostgreSQL credentials
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://username:password@localhost:5432/ai_grader?schema=public"

# AI Provider (DeepSeek is the default)
AI_PROVIDER="deepseek"
DEEPSEEK_API_KEY="your-deepseek-api-key-here"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# Optional OpenAI provider (set AI_PROVIDER="openai" to use it)
# OPENAI_API_KEY="your-openai-api-key-here"
# OPENAI_MODEL="gpt-4o"

# Future AI Providers (not yet implemented)
# ANTHROPIC_API_KEY="your-anthropic-api-key-here"
# GOOGLE_API_KEY="your-google-api-key-here"

# Application
NODE_ENV="development"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# Optional release metadata returned by GET /api/health.
# APP_VERSION="0.1.0"
# BUILD_SHA="git-commit-or-build-id"
# Readiness dependency timeout in milliseconds (1-30000).
HEALTH_CHECK_TIMEOUT_MS=3000

# Document Processing
MAX_DOCUMENT_SIZE_MB=20
STORAGE_PATH="./storage/documents"

# Spreadsheet Export
SPREADSHEET_STORAGE_PATH="./storage/spreadsheets"
MAX_SPREADSHEET_SIZE_MB=20
# Generated exports expire after this many hours. Set to 0 to disable expiry.
SPREADSHEET_EXPORT_RETENTION_HOURS=168

# Batch Operations
# Equivalent processing operations newer than this are treated as duplicates.
BATCH_OPERATION_STALE_MINUTES=30
