# Database
# Update with your PostgreSQL credentials
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://username:password@localhost:5432/ai_grader?schema=public"

# AI Provider (DeepSeek is the default)
AI_PROVIDER="deepseek"
DEEPSEEK_API_KEY="your-deepseek-api-key-here"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# Optional OpenAI provider (set AI_PROVIDER="openai" to use it)
# OPENAI_API_KEY="your-openai-api-key-here"
# OPENAI_MODEL="gpt-4o"

# Future AI Providers (not yet implemented)
# ANTHROPIC_API_KEY="your-anthropic-api-key-here"
# GOOGLE_API_KEY="your-google-api-key-here"

# Application
NODE_ENV="development"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Document Processing
MAX_DOCUMENT_SIZE_MB=20
STORAGE_PATH="./storage/documents"
