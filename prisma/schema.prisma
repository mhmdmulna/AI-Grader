// Prisma schema for AI Grader
// This defines the database structure for the application

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Courses (PBO and SISOP)
model Course {
  id          String       @id @default(cuid())
  code        String       @unique // "PBO" or "SISOP"
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assignments Assignment[]

  @@map("courses")
}

// Assignments within a course
model Assignment {
  id                 String               @id @default(cuid())
  courseId           String
  course             Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title              String
  description        String?              @db.Text
  status             String               @default("draft") // draft, active, archived
  documentId         String?              @unique // Reference to question document
  document           Document?            @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  questions          Question[]
  submissions        Submission[]
  criteria           GradingCriterion[]
  questionExtraction QuestionExtraction?

  @@index([courseId])
  @@index([status])
  @@map("assignments")
}

// Questions within an assignment
model Question {
  id               String              @id @default(cuid())
  assignmentId     String
  assignment       Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  questionNumber   Int
  type             String              @default("text") // text, code, diagram, mixed
  content          String              @db.Text // Renamed from 'text' to match extraction types
  points           Int
  rubric           String?             @db.Text
  expectedCriteria String?             @db.Text
  sourcePages      Int[]               @default([]) // Pages where question was found
  extractedFrom    String?             // "AI_EXTRACTION" or "MANUAL"
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  extractedAnswers ExtractedAnswer[]
  criteria         GradingCriterion[]

  @@unique([assignmentId, questionNumber])
  @@index([assignmentId])
  @@map("questions")
}

// Grading criteria for questions
model GradingCriterion {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  name         String
  description  String     @db.Text
  maxPoints    Int
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([assignmentId])
  @@index([questionId])
  @@map("grading_criteria")
}

// Student submissions
model Submission {
  id               String             @id @default(cuid())
  assignmentId     String
  assignment       Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentName      String
  studentId        String
  documentId       String?            @unique // Reference to submission document
  document         Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  pdfUrl           String             // Legacy field, kept for compatibility
  status           String             @default("uploaded") // uploaded, processing, extracted, graded, reviewed, finalized, error
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  extractedAnswers ExtractedAnswer[]
  answerExtraction AnswerExtraction?

  @@index([assignmentId])
  @@index([status])
  @@map("submissions")
}

// Extracted answers from submissions
model ExtractedAnswer {
  id            String              @id @default(cuid())
  submissionId  String
  submission    Submission          @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  content       String              @db.Text
  contentType   String              @default("text") // text, image, mixed
  pageNumbers   Int[]
  confidence    Float?              // Extraction confidence (0-1)
  sourcePages   Int[]               @default([]) // Duplicate of pageNumbers for API compatibility
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  grades        Grade[]
  evidence      Evidence[]

  @@index([submissionId])
  @@index([questionId])
  @@map("extracted_answers")
}

// AI-generated and human-reviewed grades
model Grade {
  id                String        @id @default(cuid())
  extractedAnswerId String
  extractedAnswer   ExtractedAnswer @relation(fields: [extractedAnswerId], references: [id], onDelete: Cascade)
  score             Float
  maxScore          Float
  evidence          String        @db.Text
  feedback          String        @db.Text
  status            String        @default("ai_generated") // ai_generated, human_reviewed, finalized
  aiProvider        String        @default("openai") // openai, claude, gemini
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  reviews           GradeReview[]

  @@index([extractedAnswerId])
  @@index([status])
  @@map("grades")
}

// Human reviews of AI-generated grades
model GradeReview {
  id               String   @id @default(cuid())
  gradeId          String
  grade            Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  reviewerName     String
  adjustedScore    Float?
  reviewerComments String?  @db.Text
  approved         Boolean  @default(false)
  reviewedAt       DateTime @default(now())

  @@index([gradeId])
  @@map("grade_reviews")
}

// Documents (assignment PDFs and submission PDFs)
model Document {
  id                String      @id @default(cuid())
  filename          String      // Stored filename (safe, unique)
  originalFilename  String      // Original filename from upload
  mimeType          String
  fileSize          Int         // Size in bytes
  storagePath       String      // Relative path in storage
  documentType      String      // assignment_question, student_submission
  processingStatus  String      @default("uploaded") // uploaded, processing, processed, failed
  errorMessage      String?     @db.Text
  pageCount         Int?
  hasText           Boolean     @default(false)
  extractedText     String?     @db.Text
  textCharCount     Int?
  metadata          Json?       // Additional PDF metadata
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  assignment        Assignment?
  submission        Submission?
  pages             DocumentPage[]

  @@index([documentType])
  @@index([processingStatus])
  @@map("documents")
}

// Individual pages within a document
model DocumentPage {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber    Int
  hasText       Boolean  @default(false)
  extractedText String?  @db.Text
  charCount     Int?
  width         Float?
  height        Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([documentId, pageNumber])
  @@index([documentId])
  @@map("document_pages")
}

// Question extraction tracking
model QuestionExtraction {
  id               String      @id @default(cuid())
  assignmentId     String      @unique
  assignment       Assignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  documentId       String
  status           String      @default("pending") // pending, processing, completed, failed
  questionCount    Int?
  aiModel          String?
  aiProvider       String?
  tokenUsage       Int?
  error            String?     @db.Text
  startedAt        DateTime?
  completedAt      DateTime?
  metadata         Json?       // Additional extraction metadata
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status])
  @@map("question_extractions")
}

// Answer extraction tracking
model AnswerExtraction {
  id               String      @id @default(cuid())
  submissionId     String      @unique
  submission       Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  documentId       String
  status           String      @default("pending") // pending, processing, completed, failed
  answerCount      Int?
  aiModel          String?
  aiProvider       String?
  tokenUsage       Int?
  error            String?     @db.Text
  startedAt        DateTime?
  completedAt      DateTime?
  metadata         Json?       // Additional extraction metadata
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  evidence         Evidence[]  // Relation to evidence

  @@index([status])
  @@map("answer_extractions")
}

// Evidence for extracted answers
model Evidence {
  id                   String            @id @default(cuid())
  answerExtractionId   String
  answerExtraction     AnswerExtraction  @relation(fields: [answerExtractionId], references: [id], onDelete: Cascade)
  extractedAnswerId    String
  extractedAnswer      ExtractedAnswer   @relation(fields: [extractedAnswerId], references: [id], onDelete: Cascade)
  type                 String            // text_match, partial_match, context_clue, page_location
  content              String?           @db.Text
  location             Json?             // Page number, character position, etc.
  confidence           Float?
  createdAt            DateTime          @default(now())

  @@index([answerExtractionId])
  @@index([extractedAnswerId])
  @@map("evidence")
}
